# Copie para .env e preencha localmente. Nunca publique o .env.
SHOPEE_MODE=
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_ACCOUNT_REFERENCE=afiliado_local
# O app define os caminhos padrão se estas variáveis forem omitidas.
SHOPEE_VERIFIED_PROFILE=
SHOPEE_HISTORY_DB=
SHOPEE_APP_DB=
# Google Trends usa dados relativos e endpoint não oficial. Ative/desative aqui.
GOOGLE_TRENDS_ENABLED=true
